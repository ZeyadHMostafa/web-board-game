# ==============================================================================
# Logs & General Empties
# ==============================================================================
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

.DS_Store
*.sw?
.idea/

# ==============================================================================
# JavaScript / Vite Frontend (apps/web)
# ==============================================================================
node_modules/
dist/
dist-ssr/
*.local
.eslintcache

# ==============================================================================
# Rust Engine (packages/core-engine)
# ==============================================================================
# Block the massive build artifact directory
/target/

# Cargo.lock is usually kept for binary apps, but for libraries inside 
# workspaces, it's often ignored. We'll leave it to track at the root if needed.
# If you want to ignore cargo locks inside packages, uncomment below:
# packages/core-engine/Cargo.lock

# ==============================================================================
# Python / ML (packages/python-ml)
# ==============================================================================
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.uv/

# Ignore compiled native python extension binaries generated by maturin/PyO3
packages/python-ml/*.so
packages/python-ml/*.whl

# ==============================================================================
# WebAssembly / Wasm-pack Outputs
# ==============================================================================
# Ignore the generated JS/Wasm binding folders built by wasm-pack
pkg/
doc/

# ==============================================================================
# VS Code Configuration
# ==============================================================================
# We allow extensions.json and your new settings.json, but ignore personal states
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json