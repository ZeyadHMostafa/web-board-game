{
  "rust-analyzer.linkedProjects": [
    "./Cargo.toml"
  ],
  "python.defaultInterpreterPath": "${workspaceFolder}/packages/python-ml/.venv/bin/python",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/packages/python-ml"
  ],
  "eslint.workingDirectories": [
    "./apps/web"
  ],
  //indentation per file (rust is 4 spaces, typescript is 2 spaces)
  "[rust]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[typescript]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  }
}